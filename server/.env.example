# Copie para .env (que NÃO vai para o GitHub) e preencha.

# Chave da API da Anthropic (fornecida pelo professor). Sem ela, os NPCs funcionam só no modo quiz.
ANTHROPIC_API_KEY=

# Modelo usado pelos NPCs
MODELO_IA=claude-haiku-5-5

# Pasta com os NPCs reais. Padrão: server/npcs/ (ignorada pelo git).
# No PC placar, aponte para o clone do repositório privado de NPCs, ex.:
# PASTA_NPCS=C:\escape\escape-room-castelo-npcs

# Senha simples do evento: o mesmo valor vai no game/config/evento.cfg dos PCs da gincana.
TOKEN_EVENTO=troque-este-token
